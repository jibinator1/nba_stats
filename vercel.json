{
  "version": 2,
  "functions": {
    "app.py": {
      "includeFiles": "{*.json,static/**,public/**,templates/**}"
    },
    "api/index.py": {
      "includeFiles": "{*.json,static/**,public/**,templates/**}"
    }
  },
  "rewrites": [
    {
      "source": "/((?!static/).*)",
      "destination": "/app.py"
    }
  ]
}
