{
  "version": 2,
  "functions": {
    "api/index.py": {
      "includeFiles": [
        "*.json",
        "*.csv",
        "static/**",
        "public/**",
        "templates/**"
      ],
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/((?!static/).*)",
      "destination": "/api/index.py?__path__=/$1"
    }
  ]
}
